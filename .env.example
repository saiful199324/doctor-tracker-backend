# Server
NODE_ENV=development
PORT=4000

# MongoDB connection string (docker-compose exposes Mongo on 27017)
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# Auth – use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Origin of the Next.js client (comma-separated for several)
CLIENT_ORIGIN=http://localhost:3000

# Credentials created by `npm run seed`
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_EMAIL=staff@doctortracker.dev
SEED_STAFF_PASSWORD=Staff@12345

# Proxies to trust for the visitor IP: a hop count (1 locally / ngrok) or
# Express subnet names, e.g. "loopback, linklocal, uniquelocal" on Render
TRUST_PROXY=1
# Header from a trusted edge proxy holding the visitor IP (Render/Cloudflare: cf-connecting-ip)
# CLIENT_IP_HEADER=
